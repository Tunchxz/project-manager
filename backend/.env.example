# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/taskhub

# Auth (must be at least 32 characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# The origin allowed by CORS and used to build links in emails
FRONTEND_URL=http://localhost:5173

# Email (optional).
# Leave both unset and new accounts are auto-verified, so the app works
# without an email provider. Set both to enable real verification emails.
SENDGRID_API_KEY=
FROM_EMAIL=

# Set to "true" to expose POST /api-v1/auth/demo-login for the public demo
ENABLE_DEMO=false
